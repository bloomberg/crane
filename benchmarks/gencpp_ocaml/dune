; OCaml baseline for benchmarks/gencpp: the same Gb* workloads through plain
; Rocq->OCaml extraction, nat as OCaml int (parity with NatInt's uint64_t).
;   dune build benchmarks/gencpp_ocaml
; writes benchmarks/gencpp_ocaml/out/gb_*.ml; see build.sh.
(coq.theory
 (name GenCppBenchOcaml)
 (modules :standard)
 (theories Stdlib GenCppBench)
 (flags (:standard -output-directory %{project_root}/benchmarks/gencpp_ocaml/out)))
