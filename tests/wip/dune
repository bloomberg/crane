 (rule
  (targets z_abs_min.t.exe)
  (deps ZAbsMin.vo z_abs_min.t.cpp (source_tree .))
  (action
   (run %{project_root}/scripts/compile-std.sh %{project_root} z_abs_min.t.exe z_abs_min.t.cpp z_abs_min.cpp)))
 (rule
  (alias runtest)
  (deps z_abs_min.t.exe)
  (action (run ./z_abs_min.t.exe))))

